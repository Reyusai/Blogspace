# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=CHANGE_ME_generate_a_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# Database Configuration (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/blogspace?retryWrites=true&w=majority
# DB_PATH=./blogspace.db (legacy SQLite path)

# CORS – Allowed frontend origin in production
CORS_ORIGIN=https://reyusai.github.io
